import 'iterators'
import 'text'
import 'math'

// =============================================================================
// CUSTOMIZATION SEAM — KSA ⇄ nShift mapping
//
// This module is the main place to adapt the integration to your data. It maps:
//   1. KSA /shippingoptions request → nShift `getOptions` request
//   2. nShift option → KSA `shipping_option` response shape
//   3. KSA selected option + nShift option → KSA `get_shipment` response shape
//
// Adjust field names, units, the `variables` record, and the tax fallback to
// match your nShift Checkout configuration and your storefront conventions.
// =============================================================================

// --- Tunable: default shipping tax rate -------------------------------------
//
// Used only when the nShift option doesn't carry an explicit taxRate of its
// own. Adjust per market. For tax-exclusive markets (e.g. NA) where shipping
// tax is computed by a tax engine after selection, set this to 0.
let DefaultShippingTaxRate = 25%

let safeText(v) =>
  from v match
    (t: text) |> t
    |> ''

let pickText(map, key: text) =>
  from map match
    { text -> value } |> safeText(map->key)
    |> ''

// --- KSA recipient → nShift receiver ---------------------------------------
let buildReceiver(recipient) =>
  let givenName = pickText(recipient, 'given_name')
  let familyName = pickText(recipient, 'family_name')
  let companyName = recipient match
    { company_name: text } |> recipient.company_name
  let name = companyName match
    (c: text) when c length > 0 |> c
    |> $'{givenName} {familyName}' trim

  from {
    name = name
    address1 = pickText(recipient, 'street_address')
    postalCode = pickText(recipient, 'postal_code')
    city = pickText(recipient, 'city')
    country = pickText(recipient, 'country') asUpperCase
    phone = recipient match
      { phone: text } |> recipient.phone
    email = recipient match
      { email: text } |> recipient.email
  }

// --- KSA request → nShift `NShiftCheckoutShippingRequest` -------------------
//
// `kustomRequest` is the parsed KSA /shippingoptions or /shipment body.
// `cartContext` is `{ channelKey, currencyCode, locale, deliveryDynamic }` —
// gathered by the ingress from the cart.
// `variables` is the nShift `variables` record. `channelKey` is required so
// the nshift module can resolve the configuration id.
export buildNShiftRequest(kustomRequest, cartContext, variables: { text -> value } | nothing) =>
  let resolvedVariables = variables match
    { text -> value } |> variables
    |> {}

  let order = kustomRequest match
    { order: { text -> value } } |> kustomRequest.order
    |> {}

  let lines = order match
    { lines: [value] } |> order.lines
    |> []

  // KSA totals are in cents
  let totalPriceCents = order match
    { total_amount: number } |> order.total_amount
    |> 0
  let totalPrice = totalPriceCents / 100

  // KSA `order.total_weight` is the authoritative grams value when set.
  // If absent, sum line attributes.
  let directWeightGrams = order match
    { total_weight: number } |> order.total_weight
  let lineWeightGrams =
    lines
    select l => l match
      { attributes: { weight: number }, quantity: number } |> l.attributes.weight * l.quantity
      |> 0
    sum
  let totalWeightGrams = directWeightGrams match
    (w: number) when w > 0 |> w
    |> lineWeightGrams
  let totalWeightKg = totalWeightGrams / 1000

  let mmCubedToCm3 line =>
    let dims = line.attributes.dimensions
    let unitVolume = dims.width * dims.height * dims.length
    from (unitVolume * line.quantity) / 1000
  let lineVolumeCm3 =
    lines
    select l => l match
      { attributes: { dimensions: { width: number, height: number, length: number } }, quantity: number } |> mmCubedToCm3(l)
      |> 0
    sum

  let locale = kustomRequest match
    { locale: text } |> kustomRequest.locale
    |> 'sv-SE'
  let languageCode = locale explode '-' first match
    (l: text) |> l
    |> 'sv'

  let currencyCode = kustomRequest match
    { currency: text } |> kustomRequest.currency
    |> 'SEK'

  let recipient = kustomRequest match
    { recipient: { text -> value } } |> kustomRequest.recipient
    |> {}

  from {
    totalPrice = totalPrice
    totalVolumeCm3 = lineVolumeCm3
    totalWeightKg = totalWeightKg
    localeId = locale
    currencyCode = currencyCode
    languageCode = languageCode
    packages = []
    variables = resolvedVariables
    receiver = buildReceiver(recipient)
  }

// --- nShift option → KSA shipping_option -----------------------------------
//
// KSA `price` and `tax_rate` are integers with two implicit decimals (cents
// and percent×100 respectively).
//
// CUSTOMIZE: `carrier` must be one of KSA's enum values (see the OpenAPI
// `carrier` schema). nShift's `carrierId` is the merchant's nShift carrier
// id; the merchant must keep this mapping in sync.
let pickType(option) =>
  from option match
    { pickupPoints: [value] } when option.pickupPoints count > 0 |> 'pickup-point'
    |> 'delivery-address'

let pickCarrier(option) =>
  // Customize: map your nShift carrier ids to KSA's `carrier` enum.
  // Falling back to `generic` is safe — KSS just doesn't render a logo.
  from option.carrierId

let pickName(option) =>
  from option match
    { title: text } |> option.title
    |> option.name

let pickTaxRate(option) =>
  from option match
    { taxRate: number } |> option.taxRate
    |> DefaultShippingTaxRate

let mapLocation(pickupPoint) =>
  from pickupPoint match
    { text -> value } |>
      let id = pickupPoint->'pickupPointId'
      let name = pickupPoint->'name'
      from {
        id = id
        name = name match
          (n: text) |> n
          |> ''
        address = {
          street_address = pickText(pickupPoint, 'address1')
          postal_code = pickText(pickupPoint, 'postalCode')
          city = pickText(pickupPoint, 'city')
          country = pickText(pickupPoint, 'countryCode') asUpperCase
        }
      }

export toKustomShippingOption(option) =>
  let price = (option.price * 100) round 0
  let taxRate = (pickTaxRate(option) * 10000) round 0
  let locations = option match
    { pickupPoints: [value] } |>
      option.pickupPoints
      select p => mapLocation(p)
      where is not nothing
      buffer
    |> nothing

  from {
    id = option.optionId
    type = pickType(option)
    carrier = pickCarrier(option)
    name = pickName(option)
    price = price
    tax_rate = taxRate
    locations = locations
  }

// --- KSA select_shipping_option → KSA get_shipment response ---------------
//
// Returned by POST /shipment, PUT /shipment/{id}, GET /shipment/{id}. The
// `shipment_id` we use is the nShift session ticket actor id.
export toKustomGetShipment(sessionActorId: uuid, option) =>
  let identifier = option match
    { shippingProductNumber: text } |> option.shippingProductNumber
    |> option match
      { carrierProductId: text } |> option.carrierProductId
      |> ''
  let productName = option match
    { title: text } |> option.title
    |> option match
      { name: text } |> option.name
      |> ''

  from {
    shipment_id = $'{sessionActorId}'
    selected_shipping_option = {
      carrier = pickCarrier(option)
      carrier_product = {
        identifier = identifier
        name = productName
      }
    }
  }
