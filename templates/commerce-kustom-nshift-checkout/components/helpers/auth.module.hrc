import 'iterators'
import 'text'
import 'json'
import 'base64'
import 'crypt'
import 'math'

// =============================================================================
// KSA /auth — TMS handshake + bearer JWT
//
// KSS sends `{ identifier, secret: { nonce, digest } }` where
// `digest = sha256(nonce + key)`. We look up our locally-configured `key`,
// compute the same digest, and compare.
//
// On success we mint a short-lived HS256 JWT signed with the same key. All
// other KSA endpoints validate the bearer locally via `verifyBearer`.
// =============================================================================

let IdentifierKey = 'apps/commerce-kustom-nshift-checkout/settings/identifier'
let KeyKey = 'apps/commerce-kustom-nshift-checkout/settings/key'
let TokenTtl = 1 hours

let configuredIdentifier = registry->IdentifierKey match
  (v: text) |> v

let configuredKey = registry->KeyKey match
  (v: text) |> v

let signSegments(headerB64: text, payloadB64: text, key: text) =>
  let signingInput = $'{headerB64}.{payloadB64}' decode text
  let keyBytes = key decode text
  from (signingInput, keyBytes) asHmacSha256 encode base64Url

let buildToken(identifier: text, key: text) =>
  let header = { alg = 'HS256', typ = 'JWT' }
  let nowEpoch = (now - 1970-01-01T00:00:00Z)::seconds::number round 0
  let expEpoch = ((now + TokenTtl) - 1970-01-01T00:00:00Z)::seconds::number round 0
  let payload = {
    iss = 'commerce-kustom-nshift-checkout'
    sub = identifier
    iat = nowEpoch
    exp = expEpoch
  }
  let headerB64 = header asJsonText decode text encode base64Url
  let payloadB64 = payload asJsonText decode text encode base64Url
  let sig = signSegments(headerB64, payloadB64, key)
  from $'{headerB64}.{payloadB64}.{sig}'

let digestForNonce(nonce: text, key: text) =>
  from $'{nonce}{key}' decode text asSha256 encode hex asUpperCase

let issueTokenIfValid(cfgId: text, cfgKey: text, body) =>
  from body match
    { identifier: text, secret: { nonce: text, digest: text } } |>
      let providedDigest = body.secret.digest asUpperCase
      let expectedDigest = digestForNonce(body.secret.nonce, cfgKey)
      let identifierOk = body.identifier == cfgId
      let digestOk = providedDigest == expectedDigest
      let credentialsMatch = identifierOk and digestOk
      from credentialsMatch match
        true |> { token = buildToken(cfgId, cfgKey) }
        |> { failure_reason = 'Invalid credentials' }
    |> { failure_reason = 'Missing identifier, nonce or digest' }

// === Public: TMS handshake ===
//
// Returns `{ token: text }` on success, or a record with `failure_reason` on
// failure (matches KSA's `authentication_malformed_request` schema).
export verifyHandshakeAndIssueToken(body) =>
  from configuredIdentifier match
    nothing |> { failure_reason = 'No identifier configured on the integration' }
    (cfgId: text) |> configuredKey match
      nothing |> { failure_reason = 'No key configured on the integration' }
      (cfgKey: text) |> issueTokenIfValid(cfgId, cfgKey, body)

let validatePayload(parsed) |>
  from parsed match
    { exp: number } |>
      let nowEpoch = (now - 1970-01-01T00:00:00Z)::seconds::number round 0
      from nowEpoch < parsed.exp match
        true |> parsed

let verifyToken(token: text, cfgKey: text) =>
  let parts = token explode '.' buffer
  from parts count match
    3 |>
      let headerB64 = parts->1 match
        (t: text) |> t
        |> ''
      let payloadB64 = parts->2 match
        (t: text) |> t
        |> ''
      let providedSig = parts->3 match
        (t: text) |> t
        |> ''
      let expectedSig = signSegments(headerB64, payloadB64, cfgKey)
      from providedSig == expectedSig match
        true |>
          let payloadText = payloadB64 decode base64Url encode text
          from payloadText parseJson validatePayload

// === Public: bearer verification ===
//
// Verifies an `Authorization: Bearer <jwt>` header. Returns the JWT payload on
// success, or `nothing` if the header is missing/malformed or the signature/
// expiry don't check out. Callers respond with HTTP 401 on `nothing`.
export verifyBearer(authorization: text | nothing) =>
  from configuredKey match
    (cfgKey: text) |>
      from authorization match
        (h: /^Bearer /) |>
          let token = h slice (7)
          from verifyToken(token, cfgKey)
