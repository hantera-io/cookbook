import 'iterators'
import 'text'

import { verifyBearer } from '../helpers/auth.module.hrc'
import { toKustomGetShipment } from '../helpers/mapping.module.hrc'

// =============================================================================
// KSA: GET /shipment/{shipment_id}
//
// `shipment_id` is the nShift session ticket actor id. Load the session via the
// graph projection, resolve the selected option from its dynamic fields, and
// return the `get_shipment` body.
// =============================================================================

param sessionActorId: uuid
param authorization: text

let loadSession(sessionActorId: uuid) =>
  let res =
    query nShiftCheckoutSessions(dynamic)
    filter $'ticketId == {sessionActorId}'
    match
      QueryError |> nothing
      (r) |> r first

  from res

let resolveSelectedOption(session) =>
  from session match
    { dynamic: { text -> value } } |>
      let dynamic = session.dynamic

      let options = dynamic->'options' match
        (v: [value]) |> v
        |> []

      let selectedOptionId = dynamic->'selectedOptionId' match
        (v: text) |> v

      from selectedOptionId match
        (sid: text) |>
          options
          where is { carrierId: text, optionId: text }
          where o => o.optionId == sid
          first

from verifyBearer(authorization) match
  nothing |> { statusCode = 401 }
  |>
    let session = loadSession(sessionActorId)
    let selectedOption = resolveSelectedOption(session)

    from selectedOption match
      { text -> value } |> {
        statusCode = 200
        content = toKustomGetShipment(sessionActorId, selectedOption)
      }
      |> { statusCode = 404 }
