import 'iterators'
import 'text'

import { verifyBearer } from '../helpers/auth.module.hrc'
import { toKustomGetShipment } from '../helpers/mapping.module.hrc'

// =============================================================================
// KSA: GET /shipment/{shipment_id}
//
// `shipment_id` is the nShift session ticket actor id. Look up the selected
// option from the ticket's dynamic fields and return the `get_shipment` body.
// =============================================================================

param shipmentId: text
param Authorization: text

let sessionActorId = shipmentId::uuid

from verifyBearer(Authorization) match
  nothing |> { statusCode = 401 }
  |> sessionActorId match
    nothing |> { statusCode = 404 }
    (id: uuid) |>
      let sessionQuery = messageActor(
        'ticket'
        id
        [{
          type = 'query'
          body = {
            `query` = { fields = ['dynamic'] }
          }
        }]
      )

      from sessionQuery match
        { data: { query: { dynamic: { text -> value } } } } |>
          let dynamic = sessionQuery.data.query.dynamic
          let options = dynamic->'options' match
            (v: [value]) |> v
            |> []
          let selectedOptionId = dynamic->'selectedOptionId' match
            (v: text) |> v

          let selectedOption = selectedOptionId match
            (sid: text) |>
              options
              where is { carrierId: text, optionId: text }
              where o => o.optionId == sid
              first

          from selectedOption match
            { text -> value } |> {
              statusCode = 200
              content = toKustomGetShipment(id, selectedOption)
            }
            |> { statusCode = 404 }
        |> { statusCode = 404 }
