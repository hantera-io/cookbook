import 'iterators'
import 'text'
import 'json'
import 'maps'

import { getOptions } from '/apps/nshift-checkout/nshift.module.hrc'
import { verifyBearer } from '../helpers/auth.module.hrc'
import { resolveCartIdByKustomOrderId } from '../helpers/cart-resolution.module.hrc'
import { buildNShiftRequest, toKustomShippingOption } from '../helpers/mapping.module.hrc'

// =============================================================================
// KSA: POST /shippingoptions
//
// Bearer-authenticated. Resolves the cart from the `cart:<uuid>` tag injected
// by apps.psp.kustom on order creation, renders the cart context, calls the
// nShift module's getOptions, persists the resulting `sessionActorId` onto
// the cart's `deliveryDynamicFields` (so subsequent /shipment calls can
// route the selection), and projects the options to KSA's shape.
// =============================================================================

param body: [byte]
param authorization: text

let parsedBody = body encode text parseJson

let order = parsedBody match
  { order: { text -> value } } |> parsedBody.order
  |> {}

let kustomOrderId = order->'id' match
  ( id: text ) |> id

let cartId = kustomOrderId match
  (id: text) |> resolveCartIdByKustomOrderId(id)

from verifyBearer(authorization) match
  nothing |> { statusCode = 401 }
  |> cartId match
    nothing |> {
      statusCode = 400
      content = {
        failure_reason = 'Missing order.id, or no Hantera cart matches it'
      }
    }
    (resolvedCartId: uuid) |>
      let cartQuery = messageActor(
        'ticket'
        resolvedCartId
        [{
          type = 'complete'
        },{
          type = 'query'
          body = {
            `query` = {
              fields = ['dynamic']
              navigate = [{
                edge = 'order'
                node = {
                  fields = ['channelKey', 'currencyCode', 'locale']
                }
              }]
            }
          }
        }]
        true
      )

      from cartQuery match
        { data: { query: {
          dynamic: { text -> value }
          order: { channelKey: text, currencyCode: text, locale: text }
        } } } |>
          let dynamic = cartQuery.data.query.dynamic
          let cartOrder = cartQuery.data.query.order

          let deliveryDynamic = dynamic->'deliveryDynamicFields' match
            (d: { text -> value }) |> d
            |> {}

          let existingSessionActorId = deliveryDynamic->'nShiftCheckoutSessionActorId' match
            (id: uuid) |> id

          let cartContext = {
            channelKey = cartOrder.channelKey
            currencyCode = cartOrder.currencyCode
            locale = cartOrder.locale
            deliveryDynamic = deliveryDynamic
          }

          // CUSTOMIZE: inject nShift variables here. The mapping helper requires
          // `channelKey` so the nShift module can resolve the checkout
          // configuration id from `channels/<channelKey>.nshiftCheckoutConfigurationId`.
          let variables = {
            channelKey = cartOrder.channelKey
          }

          let nshiftRequest = buildNShiftRequest(parsedBody, cartContext, variables)
          let result = getOptions(existingSessionActorId, nshiftRequest)

          from result match
            {
              sessionActorId: uuid,
              options: [{
                optionId: uuid,
                shippingProductNumber: text,
                carrierId: text,
                carrierProductId: text,
                name: text,
                title: text | nothing,
                price: number,
                originalPrice: number | nothing,
                taxRate: number | nothing,
                priceDescription: text | nothing,
                logoUrl: text | nothing,
                texts: [text] | nothing,
                valid: bool | nothing,
                additionalValues: { text -> value } | nothing,
                pickupPoints: [value] | nothing
              }]
            } |>
              let newDynamic = {
                nShiftCheckoutSessionActorId = result.sessionActorId
              } entries
              let updatedDynamic = [deliveryDynamic entries, newDynamic] flatten asMap

              from messageActor(
                'ticket'
                resolvedCartId
                [{
                  type = 'applyCommands'
                  body = {
                    commands = [{
                      type = 'setDynamicFields'
                      fields = { deliveryDynamicFields = updatedDynamic }
                    }]
                  }
                }]
                false
              ) match
                |> {
                  statusCode = 200
                  content = {
                    shipping_options =
                      result.options
                      select o => toKustomShippingOption(o)
                      buffer
                  }
                }
            Error |> {
              statusCode = 502
              content = { failure_reason = result.error.message }
            }
        |> {
          statusCode = 404
          content = { failure_reason = 'Cart not found or not in a renderable state' }
        }
